rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Modelo propuesto: cada actividad tiene dueño autenticado.
    match /usuarios/{userId}/actividades/{actividadId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Denegar por defecto las colecciones antiguas y salas públicas
    // hasta contar con autenticación, membresía y caducidad verificada.
    match /{document=**} { allow read, write: if false; }
  }
}
